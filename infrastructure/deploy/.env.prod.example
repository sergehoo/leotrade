# Copier ce fichier vers .env.prod, puis remplacer toutes les valeurs REPLACE_*.
COMPOSE_PROJECT_NAME=leotrade
APP_IMAGE=leotrade:latest
DJANGO_ENV=prod
DEBUG=False

SECRET_KEY=REPLACE_WITH_AT_LEAST_64_RANDOM_CHARACTERS
FERNET_SECRET_KEY=REPLACE_WITH_A_STABLE_FERNET_KEY
METRICS_AUTH_TOKEN=REPLACE_WITH_A_RANDOM_METRICS_TOKEN

ALLOWED_HOSTS=leotrade.com,www.leotrade.com
SITE_URL=https://leotrade.com
SITE_BASE_URL=https://leotrade.com
CSRF_TRUSTED_ORIGINS=https://leotrade.com,https://www.leotrade.com
CORS_ALLOWED_ORIGINS=https://leotrade.com,https://www.leotrade.com

POSTGRES_DB=leotrade
POSTGRES_USER=leotrade
POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_DATABASE_PASSWORD
REDIS_PASSWORD=REPLACE_WITH_A_RANDOM_URL_SAFE_REDIS_PASSWORD
DB_CONN_MAX_AGE=60

TRAEFIK_APP_HOST=leotrade.com
TRAEFIK_FLOWER_HOST=tasks.leotrade.com
TRAEFIK_NETWORK=proxy
TRAEFIK_CERT_RESOLVER=lets
TRAEFIK_SHARED_MIDDLEWARES=compress@docker,ratelimit@docker
ALLAUTH_TRUSTED_PROXY_COUNT=1
FLOWER_BASIC_AUTH=admin:REPLACE_WITH_A_RANDOM_FLOWER_PASSWORD
WEB_CONCURRENCY=2
CELERY_WORKER_CONCURRENCY=2

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=REPLACE_WITH_SMTP_HOST
EMAIL_PORT=587
EMAIL_HOST_USER=REPLACE_WITH_SMTP_USER
EMAIL_HOST_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=LeoTrade <no-reply@leotrade.com>
SERVER_EMAIL=errors@leotrade.com

PAYMENT_DEFAULT_PROVIDER=PAYSTACK
PAYSTACK_PUBLIC_KEY=pk_live_REPLACE_ME
PAYSTACK_SECRET_KEY=sk_live_REPLACE_ME
PAYSTACK_SUPPORTED_CURRENCIES=XOF,NGN,GHS,KES,ZAR,USD
WALLET_DEFAULT_CURRENCY=XOF

STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ADYEN_API_KEY=
ADYEN_MERCHANT_ACCOUNT=
ADYEN_HMAC_KEY=
ADYEN_ENV=LIVE

FEATURE_TRADING_ENABLED=False
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0

AI_PRIMARY_PROVIDER=DEEPSEEK
AI_SECONDARY_PROVIDER=CLAUDE
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
